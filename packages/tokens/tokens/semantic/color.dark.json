{
  "color": {
    "bg": {
      "primary": { "$type": "color", "$value": "{color.gray.900}" },
      "secondary": { "$type": "color", "$value": "{color.gray.800}" },
      "tertiary": { "$type": "color", "$value": "{color.gray.700}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.white}" },
      "secondary": { "$type": "color", "$value": "{color.gray.300}" },
      "tertiary": { "$type": "color", "$value": "{color.gray.500}" },
      "inverse": { "$type": "color", "$value": "{color.gray.900}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.gray.700}" },
      "strong": { "$type": "color", "$value": "{color.gray.600}" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "{color.blue.500}" },
      "hover": { "$type": "color", "$value": "{color.blue.400}" },
      "subtle": { "$type": "color", "$value": "{color.blue.900}" },
      "text": { "$type": "color", "$value": "{color.blue.400}" },
      "on-accent": { "$type": "color", "$value": "{color.white}" }
    },
    "success": {
      "default": { "$type": "color", "$value": "{color.green.500}" },
      "bg": { "$type": "color", "$value": "{color.green.900}" }
    },
    "error": {
      "default": { "$type": "color", "$value": "{color.red.500}" },
      "bg": { "$type": "color", "$value": "{color.red.900}" }
    }
  }
}
