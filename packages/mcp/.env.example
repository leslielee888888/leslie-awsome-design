# Comma-separated hostnames/IPs this server is reachable by. Required for any
# real LAN client to connect - createMcpExpressApp()'s default DNS-rebinding
# protection only accepts Host: localhost/127.0.0.1/[::1], so every real
# request gets a 403 "Invalid Host" until this is set to match how clients
# actually reach this container (its NAS hostname and/or LAN IP).
ALLOWED_HOSTS=192.168.1.176,leslie-nas.local

# Host-side port to publish the container's port 3000 on. Optional - defaults
# to 3000 if unset.
HOST_PORT=3000
